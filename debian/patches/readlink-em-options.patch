-                       "\0" "=1");
+	opt = getopt32(argv, "^" "n" IF_FEATURE_READLINK_FOLLOW("fvsqem")
+                       "\0" "=1:e--fm:f--em:m--ef");
 
 	/* compat: coreutils readlink reports errors silently via exit code */
 	if (!(opt & 4)) /* not -v */
@@ -81,6 +115,10 @@ int readlink_main(int argc UNUSED_PARAM,
 	/* NOFORK: only one alloc is allowed; must free */
