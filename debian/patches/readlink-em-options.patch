 		buf = xmalloc_realpath_coreutils(argv[optind]);
+	} else if (opt & 32) { /* -e */
+		buf = xmalloc_realpath(argv[optind]);
+	} else if (opt & 64) { /* -m */
+		buf = readlink_m(argv[optind]);
 	} else {
 		buf = xmalloc_readlink_or_warn(argv[optind]);
 	}
