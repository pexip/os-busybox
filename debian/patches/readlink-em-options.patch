@@ -64,6 +66,38 @@
  * behavior which means we'd have to implement the full stack ourselves :(.
  */
 
+#if ENABLE_FEATURE_READLINK_FOLLOW
+static char* readlink_m(const char *path)
+{
+	char *buf, *tail = NULL;
+
+	errno = 0;
+	buf = xmalloc_realpath(path);
+	while (!buf && errno == ENOENT) {
+		char *new_tail = strrchr(path, '/');
+		if (tail) {
+			*tail = '/';
+		}
+		if (new_tail) {
+			*new_tail = '\0';
+			tail = new_tail;
+			buf = xmalloc_realpath(path);
+		} else {
+			break;
+		}
+	}
+
+	if (buf && !errno && tail) {
+		unsigned len = strlen(buf);
+		buf = xrealloc(buf, len + strlen(tail + 1) + 2);
+		buf[len++] = '/';
+		strcpy(buf + len, tail + 1);
+	}
+
+	return buf;
+}
+#endif
+
 int readlink_main(int argc, char **argv) MAIN_EXTERNALLY_VISIBLE;
 int readlink_main(int argc UNUSED_PARAM, char **argv)
 {
